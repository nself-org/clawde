{
  "name": "clawde",
  "version": "0.3.5",
  "license": "MIT",
  "private": true,
  "description": "ClawDE \u2014 AI dev environment JS/TS workspace root (RN mobile + @nself/* shared packages)",
  "scripts": {
    "mobile": "pnpm --filter @clawde/mobile start",
    "mobile:ios": "pnpm --filter @clawde/mobile ios",
    "mobile:android": "pnpm --filter @clawde/mobile android",
    "typecheck": "pnpm -r run type-check",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "markdown-it@<12.3.2": ">=12.3.2",
      "esbuild@<=0.24.2": ">=0.25.0",
      "vite@<=6.4.1": ">=6.4.2",
      "postcss@<8.5.10": ">=8.5.10",
      "@xmldom/xmldom@<0.8.12": ">=0.8.12",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "uuid@<11.1.1": ">=11.1.1",
      "vitest@<3.2.6": ">=3.2.6",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "vite@<=6.4.2": ">=6.4.3",
      "js-yaml@<=4.1.1": ">=4.2.0",
      "markdown-it@<=14.1.1": ">=14.2.0",
      "dompurify@<=3.4.10": ">=3.4.11",
      "immutable": ">=5.1.8",
      "js-yaml": ">=4.3.1",
      "linkify-it": ">=5.0.2",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.18",
      "shell-quote": ">=1.9.0",
      "tar": ">=7.5.19",
      "undici": ">=7.29.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@3": "5.0.9",
      "brace-expansion@4": "5.0.9",
      "brace-expansion@5": "5.0.9",
      "browserslist@<4.28.7": "^4.28.7"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-71330",
        "CVE-2025-71329"
      ]
    }
  }
}
